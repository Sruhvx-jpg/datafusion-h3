# Server Configuration
HOST=0.0.0.0
PORT=4433
APP_ENV=production

# QUIC Transport Settings
IDLE_TIMEOUT_SECS=30
KEEP_ALIVE_SECS=10

# Production TLS (Provide valid PEM files in production)
TLS_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# Storage & Database (Turso LibSQL)
DATABASE_URL=libsql://your-turso-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Upstash Redis Cache (TLS Enabled)
REDIS_URL=rediss://default:your-token@your-host.upstash.io:6379

